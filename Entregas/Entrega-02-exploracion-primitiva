rect(0, 250, 220, 10)
rect(208, 250, 12, 251)
rect(100, 350, 170, 15)
rect(255, 350, 15, 170)
rect(100, 350, 15, 170)
  
  ///lineas angulares abajo///
  
  stroke(0)
  strokeWeight(2);
  
line(228, 312, 0, 460); //1
line(228, 312, 0, 470); //2
line(228, 312, 0, 480); //3
line(228, 312, 0, 490); //4
line(228, 312, 0, 500); //5
line(228, 312, 0, 490); //6
line(228, 312, 15, 500); //7
line(228, 312, 30, 500); //8
  

  ///lineas angulares arriba///
  
   stroke(0)
  strokeWeight(2);
  
line(0, 80, 228, 308); //1
line(0, 90, 228, 308); //2
line(0, 100, 228, 308); //3
line(0, 110, 228, 308); //4
line(0, 120, 228, 308); //5
line(0, 130, 228, 308); //6
line(0, 140, 228, 308); //7
line(0, 150, 228, 308); //8
  
  ///rectangulos arriba///
  
  noFill()
  stroke(310, 260, 255);
  strokeWeight(10);
rect(330, -20, 200, 90)
  
   noFill()
  stroke(310, 260, 255);
  strokeWeight(10);
rect(350, -20, 200, 200)
  
  noFill()
  stroke(310, 260, 255);
  strokeWeight(10);
rect(380, 100, 100, 120)
  
