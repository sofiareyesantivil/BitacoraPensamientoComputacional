function setup() {
  createCanvas(400, 500);
}

function draw() {
  background(240, 255);

  
  ///rectangulos///
  
  fill(0)
  stroke(0);
rect(296, 60, 13, 500)
  
  
  ///circulos///
  
  noStroke(0)
  
  fill(220, 40, 50);        //rojo
circle(290, 330,200)
  fill(150, 255);           //gris
circle(50, 50, 360)
  fill(240, 255);           //blanco
circle(50, 50, 310)
