circle(250, 180, 20)
  fill(0);                  //negro 1
circle(45, 350, 30)
  fill(0);                  //negro 2
circle(365, 30, 10)
  
  ///lineas verticales///

  stroke(0)
  strokeWeight(2);
  
line(0, 30, 310, 30); //1 
line(0, 50, 250, 50); //2
  
  ///lineas horizontales///
  
  stroke(0); //color del borde
  strokeWeight(2); //grosor
  
line(30, 0, 30, 310); //1
line(50, 0, 50, 250); //2

