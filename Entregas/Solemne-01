  // creé una figura con forma de estrella con 10 picos
push()
  translate(width / 3, height / 10)
  fill(237, 208, 130);  //amarillo apagado
  noStroke();
  //funcion nueva de estrella con varios picos
  drawStar(60, 140, 110, 170, 12); 
  
  
}



function drawStar(x, y, radio1, radio2, nPicos) {
  let angulo = 360 / nPicos; // este hace la diferencia de grados entre los picos
  let medioAngulo = angulo / 2; // con este movemos la parte interna de los puntoss 
  
  beginShape();
  
    for (let a = 0; a < 360; a += angulo) {
    
    //puntos exteriores (punta de cada pico)
    let sx = 60 + cos(a) * 170;
    let sy = 140 + sin(a) * 170;
    vertex(sx, sy);
    
    //puntos interiores (espacio entre los picos)
    let nx = 60 + cos(a + medioAngulo) * 110;
    let ny = 140 + sin(a + medioAngulo) * 110;
    vertex(nx, ny);
      
      
      
  }
  endShape(CLOSE);
pop()
  
  //push y pop para que la funcion solo afecte a una cosa y no a mi lienzo completo
  

                                //fin de la figura de estrella
  
  
  
  
  
